# ─────────────────────────────────────────────────────────
# Government of Assam Portal — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# CORS — URL of your frontend (the HTML file or live server)
CLIENT_ORIGIN=http://localhost:5500

# JWT Authentication
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# Database (SQLite file path)
DB_PATH=./db/assam_portal.db

# Admin credentials (used by seed script — change before production!)
ADMIN_EMAIL=admin@assam.gov.in
ADMIN_PASSWORD=Admin@Assam2026!

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File uploads
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
