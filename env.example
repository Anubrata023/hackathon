const express = require('express');
const router = express.Router();
const db = require('../db');

/**
 * GET /api/consumers/:consumerId
 * Fetch consumer details + current unpaid bill
 */
router.get('/:consumerId', (req, res) => {
  const { consumerId } = req.params;

  const consumer = db.prepare(`
    SELECT * FROM consumers WHERE consumer_id = ?
  `).get(consumerId);

  if (!consumer) {
    return res.status(404).json({ success: false, message: 'Consumer not found. Please verify your Consumer ID.' });
  }

  // Get latest unpaid bill
  const bill = db.prepare(`
    SELECT * FROM bills
    WHERE consumer_id = ? AND status = 'UNPAID'
    ORDER BY due_date DESC
    LIMIT 1
  `).get(consumerId);

  res.json({
    success: true,
    data: {
      consumer: {
        consumer_id: consumer.consumer_id,
        name: consumer.name,
        meter_number: consumer.meter_number,
        mobile: consumer.mobile,
        email: consumer.email,
        division: consumer.division,
        address: consumer.address,
        tariff_type: consumer.tariff_type
      },
      bill: bill || null
    }
  });
});

/**
 * GET /api/consumers/:consumerId/bills
 * Get all bills for a consumer (optional ?month= filter)
 */
router.get('/:consumerId/bills', (req, res) => {
  const { consumerId } = req.params;
  const { month } = req.query;

  const consumer = db.prepare(`SELECT consumer_id FROM consumers WHERE consumer_id = ?`).get(consumerId);
  if (!consumer) return res.status(404).json({ success: false, message: 'Consumer not found.' });

  let query = `SELECT * FROM bills WHERE consumer_id = ?`;
  const params = [consumerId];

  if (month) {
    query += ` AND bill_month LIKE ?`;
    params.push(`%${month}%`);
  }

  query += ` ORDER BY due_date DESC`;

  const bills = db.prepare(query).all(...params);
  res.json({ success: true, data: bills });
});

/**
 * GET /api/consumers/:consumerId/history
 * Get payment history
 */
router.get('/:consumerId/history', (req, res) => {
  const { consumerId } = req.params;

  const consumer = db.prepare(`SELECT consumer_id FROM consumers WHERE consumer_id = ?`).get(consumerId);
  if (!consumer) return res.status(404).json({ success: false, message: 'Consumer not found.' });

  const history = db.prepare(`
    SELECT * FROM payment_history WHERE consumer_id = ?
    ORDER BY paid_at DESC
    LIMIT 12
  `).all(consumerId);

  res.json({ success: true, data: history });
});

module.exports = router;
