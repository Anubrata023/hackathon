const express = require('express');
const router  = express.Router();
const db      = require('../database');
const { authenticate, isAdmin } = require('../middleware/auth');

// ─── GET /api/usage  — full usage history for logged-in user ─────────────────
router.get('/', authenticate, (req, res) => {
  const meter = db.prepare('SELECT * FROM meters WHERE consumer_id = ?').get(req.user.consumer_id);
  if (!meter) {
    return res.json({ success: true, data: { meter: null, readings: [], monthly_summary: [] } });
  }

  const readings = db.prepare(`
    SELECT * FROM meter_readings
    WHERE meter_id = ?
    ORDER BY reading_date DESC
    LIMIT 24
  `).all(meter.id);

  // Aggregate last 12 months
  const monthly = db.prepare(`
    SELECT strftime('%Y-%m', reading_date) AS month,
           SUM(units_consumed)            AS total_units,
           COUNT(*)                       AS readings
    FROM meter_readings
    WHERE meter_id = ?
    GROUP BY month
    ORDER BY month DESC
    LIMIT 12
  `).all(meter.id);

  res.json({ success: true, data: { meter, readings, monthly_summary: monthly } });
});

// ─── GET /api/usage/meter-info ───────────────────────────────────────────────
router.get('/meter-info', authenticate, (req, res) => {
  const meter = db.prepare('SELECT * FROM meters WHERE consumer_id = ?').get(req.user.consumer_id);
  res.json({ success: true, data: meter || null });
});

// ─── GET /api/usage/live  — simulated real-time reading ─────────────────────
router.get('/live', authenticate, (req, res) => {
  const meter = db.prepare('SELECT * FROM meters WHERE consumer_id = ?').get(req.user.consumer_id);
  if (!meter) {
    return res.status(404).json({ success: false, message: 'No smart meter found for this account' });
  }

  // Simulate hourly load curve (24 hrs)
  const hours = Array.from({ length: 24 }, (_, h) => {
    const base    = 0.3 + Math.random() * 0.4;
    const peak    = (h >= 7 && h <= 9) || (h >= 18 && h <= 22) ? base * 1.8 : base;
    return { hour: `${String(h).padStart(2, '0')}:00`, kw: parseFloat(peak.toFixed(3)) };
  });

  const lastReading = db.prepare(
    'SELECT current_reading FROM meter_readings WHERE meter_id = ? ORDER BY reading_date DESC LIMIT 1'
  ).get(meter.id);

  res.json({
    success: true,
    data: {
      meter_number: meter.meter_number,
      current_reading_kwh: lastReading?.current_reading || 0,
      sanctioned_load_kw: meter.sanctioned_load,
      hourly_load: hours,
      timestamp: new Date().toISOString()
    }
  });
});

// ─── POST /api/usage/reading  (admin — record a meter reading) ───────────────
router.post('/reading', authenticate, isAdmin, (req, res) => {
  try {
    const { consumer_id, reading_date, current_reading } = req.body;

    if (!consumer_id || !reading_date || current_reading == null) {
      return res.status(400).json({ success: false, message: 'consumer_id, reading_date and current_reading required' });
    }

    const meter = db.prepare('SELECT * FROM meters WHERE consumer_id = ?').get(consumer_id);
    if (!meter) return res.status(404).json({ success: false, message: 'Meter not found for this consumer' });

    const last = db.prepare(
      'SELECT current_reading FROM meter_readings WHERE meter_id = ? ORDER BY reading_date DESC LIMIT 1'
    ).get(meter.id);

    const prev   = last?.current_reading || 0;
    const units  = parseFloat((parseFloat(current_reading) - prev).toFixed(2));

    if (units < 0) {
      return res.status(400).json({ success: false, message: 'Current reading cannot be less than previous reading' });
    }

    db.prepare(`
      INSERT INTO meter_readings
        (meter_id, consumer_id, reading_date, previous_reading, current_reading, units_consumed, recorded_by)
      VALUES (?, ?, ?, ?, ?, ?, ?)
    `).run(meter.id, consumer_id, reading_date, prev, parseFloat(current_reading), units, req.user.id);

    res.status(201).json({
      success: true,
      message: 'Meter reading recorded',
      data: { previous_reading: prev, current_reading: parseFloat(current_reading), units_consumed: units }
    });
  } catch (err) {
    res.status(500).json({ success: false, message: err.message });
  }
});

module.exports = router;
