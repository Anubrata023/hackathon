const express = require('express');
const router = express.Router();
const db = require('../db');

/**
 * GET /api/bills/:billId
 * Get a single bill by its ID
 */
router.get('/:billId', (req, res) => {
  const bill = db.prepare(`SELECT * FROM bills WHERE id = ?`).get(req.params.billId);
  if (!bill) return res.status(404).json({ success: false, message: 'Bill not found.' });
  res.json({ success: true, data: bill });
});

/**
 * GET /api/bills/consumer/:consumerId/month/:month
 * Get bill for a specific consumer + month
 */
router.get('/consumer/:consumerId/month/:month', (req, res) => {
  const { consumerId, month } = req.params;

  const bill = db.prepare(`
    SELECT * FROM bills
    WHERE consumer_id = ? AND bill_month LIKE ?
    ORDER BY due_date DESC
    LIMIT 1
  `).get(consumerId, `%${month}%`);

  if (!bill) return res.status(404).json({ success: false, message: 'Bill not found for that month.' });
  res.json({ success: true, data: bill });
});

module.exports = router;
